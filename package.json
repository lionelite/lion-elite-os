{
  "name": "lion-elite-os",
  "version": "2.1.0",
  "description": "Lion Elite OS automation dashboard with PostgreSQL, Redis queues, executive orchestration, integration gateway, validated outreach, and real estate intelligence.",
  "main": "server.js",
  "type": "commonjs",
  "scripts": {
    "start": "node server.js",
    "dev": "node server.js",
    "outreach": "node outreach-server-postgres.js",
    "executive": "node executive-orchestrator.js",
    "integrations": "node integration-gateway-server.js",
    "worker:outreach": "node workers/outreach-worker.js",
    "worker:executive": "node workers/executive-worker.js",
    "worker:integrations": "node workers/integration-worker.js",
    "db:migrate": "node scripts/migrate.js",
    "validate:render": "node scripts/validate-render-blueprint.js",
    "outreach:kill-switch": "node scripts/outreach-kill-switch.js",
    "social:generate": "node scripts/generate-social-content.js",
    "social:publish": "node scripts/publish-social-content.js",
    "listen:bluesky": "node social-listening/src/monitor.js",
    "listen:review": "node social-listening/src/review-server.js",
    "listen:replay": "node social-listening/src/replay.js",
    "listen:opportunities": "node social-listening/src/opportunity-analyzer.js",
    "real-estate": "node real-estate/intelligence/src/dashboard-server.js",
    "real-estate:demo": "node real-estate/intelligence/src/demo.js",
    "real-estate:import": "node real-estate/intelligence/src/import-csv.js",
    "test": "node --test test/*.test.js real-estate/intelligence/test/*.test.js business-scaling/founder-intelligence/test/*.test.js social-listening/test/*.test.js"
  },
  "dependencies": {
    "bullmq": "^5.34.10",
    "express": "^4.19.2",
    "ioredis": "^5.4.2",
    "pg": "^8.13.1"
  },
  "engines": {
    "node": ">=20"
  }
}
