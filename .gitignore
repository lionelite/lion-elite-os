node_modules/
bun.lock
bun.lockb
.env
*.log

# Social-listening monitor output (third-party post content stays local)
social-listening/data/

# Generated Claude Code lead context (contains third-party public post content)
claude-context/

# Agency client discovery files and engagement ledgers.
# These hold client financials (revenue, lead volume, customer value) and our
# own delivery costs and margins. Contractors are granted `repo-branch` access
# by design (agency/src/access.js), so committing this data would route it
# straight through the access tier built to keep them away from it.
agency/clients/
agency/ledgers/
agency/bench/

# Harvested lead store is pulled from the automation/leads branch on demand.
leads/harvested/

# BuildPipeline funnel app build output. No lockfile is committed here either
# (same policy as the root: docs/render-dependency-policy.md).
apps/buildpipeline/.next/
apps/buildpipeline/tsconfig.tsbuildinfo
apps/buildpipeline/package-lock.json
dump.rdb

# Obsidian (the repo root is an Obsidian vault — see knowledge/obsidian.md).
# Shared vault settings in .obsidian/ are committed; per-device window state,
# caches, trash and downloaded plugin code are not.
.obsidian/workspace.json
.obsidian/workspace-mobile.json
.obsidian/cache
.obsidian/plugins/*/main.js
.obsidian/plugins/*/manifest.json
.obsidian/plugins/*/styles.css
.trash/
