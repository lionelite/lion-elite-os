# Render Environment Variables
# Do not commit real secret values.

# Activates AI-powered agent generations.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# Lion Elite Coaching PWA. Use a long random production value and never
# expose it to clients. COACHING_DEMO_MODE is for local/testing only.
#
# COACH_PORTAL_ADMIN_TOKEN is the OWNER's sign-in token. Every other coach gets
# their own token, issued from the Coaches tab and stored only as a hash. Do not
# share this one with a coach: the owner role sees every client on the platform.
COACH_PORTAL_ADMIN_TOKEN=
COACHING_PUBLIC_URL=
COACHING_DEMO_MODE=false

# Signs unsubscribe links so an address cannot be used to enumerate or bulk
# unsubscribe. Optional: without it links are unsigned and STILL work, because
# a refused opt-out is a CAN-SPAM problem, not a security win.
UNSUBSCRIBE_SECRET=
# Public origin used to build unsubscribe links in email footers.
PUBLIC_BASE_URL=

# Identity of the owner account bootstrapped from COACH_PORTAL_ADMIN_TOKEN.
# COACH_OWNER_NAME is what clients see on messages from the owner.
COACH_OWNER_NAME=Coach Alex
COACH_OWNER_EMAIL=owner@lionelite.internal

# Optional private message alerts. Generate a matching VAPID pair with:
# npx web-push generate-vapid-keys
WEB_PUSH_PUBLIC_KEY=
WEB_PUSH_PRIVATE_KEY=
WEB_PUSH_SUBJECT=mailto:info@lionelitebeauty.com

# Allows the dashboard to save approved agent outputs back to GitHub.
# Use a GitHub token with access to this repository.
GITHUB_TOKEN=
GITHUB_REPO=lionelite/lion-elite-os
GITHUB_BRANCH=main
