# Render Environment Variables
# Do not commit real secret values.

# Activates AI-powered agent generations.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# Lion Elite Coaching PWA. Use a long random production value and never
# expose it to clients. COACHING_DEMO_MODE is for local/testing only.
#
# COACH_PORTAL_ADMIN_TOKEN is the OWNER's sign-in token. Every other coach gets
# their own token, issued from the Coaches tab and stored only as a hash. Do not
# share this one with a coach: the owner role sees every client on the platform.
COACH_PORTAL_ADMIN_TOKEN=
COACHING_PUBLIC_URL=
COACHING_DEMO_MODE=false

# Signs unsubscribe links so an address cannot be used to enumerate or bulk
# unsubscribe. Optional: without it links are unsigned and STILL work, because
# a refused opt-out is a CAN-SPAM problem, not a security win.
UNSUBSCRIBE_SECRET=
# Public origin used to build unsubscribe links in email footers.
PUBLIC_BASE_URL=

# Identity of the owner account bootstrapped from COACH_PORTAL_ADMIN_TOKEN.
# COACH_OWNER_NAME is what clients see on messages from the owner.
COACH_OWNER_NAME=Coach Alex
COACH_OWNER_EMAIL=owner@lionelite.internal

# Optional private message alerts. Generate a matching VAPID pair with:
# npx web-push generate-vapid-keys
WEB_PUSH_PUBLIC_KEY=
WEB_PUSH_PRIVATE_KEY=
WEB_PUSH_SUBJECT=mailto:info@lionelitebeauty.com

# Allows the dashboard to save approved agent outputs back to GitHub.
# Use a GitHub token with access to this repository.
GITHUB_TOKEN=
GITHUB_REPO=lionelite/lion-elite-os
GITHUB_BRANCH=main

# Coaching welcome SMS (scripts/send-coaching-welcome-sms.js). Sending is off
# until SMS_SEND_ENABLED=true AND the Twilio values exist; the scheduled run
# reports why it stopped and sends nothing until then. Consent, quiet hours,
# opt-out, once-per-lead and the daily cap are enforced regardless.
SMS_SEND_ENABLED=false
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_MESSAGING_SERVICE_SID=
DAILY_SMS_LIMIT=50

# ---------------------------------------------------------------------------
# SEND CONTROLS — the switches that decide whether anything reaches a person.
#
# Every one of these is OFF here and must stay off until a human deliberately
# turns it on in the Render dashboard. They are written down because an
# undocumented kill switch is a foot-gun for whoever eventually flips it, not
# because they are ready to flip. Claude does not set them.
#
# Leaving a value blank is not the same as setting it to false in every case —
# each path below states its own fail-closed behaviour.
# ---------------------------------------------------------------------------

# B2B/B2C e-mail sending (lib/email-delivery.js → Resend).
# ALL THREE are required or lib/email-delivery.js throws on the first send
# attempt — that is the fail-closed default, not a bug. Enablement checklist
# (Resend domain verification → vars set with the flag still off → self-addressed
# test → enable → deliverability ramp) and the kill-switch runbook are in
# docs/automated-outreach.md. Never commit or echo the API key.
OUTREACH_SEND_ENABLED=false
RESEND_API_KEY=
OUTREACH_FROM_EMAIL=
# Optional, but the consumer campaign needs the last two for CAN-SPAM: a working
# unsubscribe path and a real postal address.
OUTREACH_REPLY_TO=
OUTREACH_UNSUBSCRIBE_EMAIL=
OUTREACH_POSTAL_ADDRESS=
# Transactional daily quota. Applies to every send path regardless of campaign.
DAILY_EMAIL_LIMIT=100

# Own-brand social publishing (lib/social/publishers/*). Set as a GitHub repo
# VARIABLE for .github/workflows/daily-social-content.yml, and per-platform
# credentials are separate. Content generation runs with zero secrets and simply
# does not publish while this is off.
SOCIAL_PUBLISH_ENABLED=false

# Bluesky replies — ONLY to posts that structurally @-mention the configured bot
# DID. Cold replies, DMs, likes and follows stay prohibited; do not widen
# isExplicitlyTagged. BOTH of these are required, explicitly, because before that
# fix the defaults keyed off the mere presence of credentials and adding them
# would have begun posting live.
BLUESKY_OUTREACH_ENABLED=false
BLUESKY_OUTREACH_DRY_RUN=true
# Credentials are needed for replies only. The Jetstream LISTENER needs no
# account at all and runs by default; disable it with BLUESKY_LISTENER_ENABLED=false.
BLUESKY_HANDLE=
BLUESKY_APP_PASSWORD=

# Paid advertising: THERE IS NO ENV VAR FOR THE SPEND CAP, deliberately.
# lib/ads/ generates launch plans and spends nothing; connecting billing and
# setting a daily budget happen in Ads Manager, by the owner. Per CLAUDE.md, if
# no cap has been established one must be obtained before any paid media spend.
# The agent roster treats this as a human decision that no variable can satisfy
# (lib/agents/coordinator.js), so do not add a cap variable here expecting it to
# authorize anything — it would look like authorization while governing nothing.

# ---------------------------------------------------------------------------
# Agent roster targets (lib/agents/roles.js). Safe to change; they only set the
# number the executive loop measures the day's gap against.
# ---------------------------------------------------------------------------
DAILY_REVENUE_TARGET=3500
DAILY_REVENUE_STRETCH=5000

# Licensed B2B contact data. A provider record must carry providerId + licenceRef
# + acquiredAt + region, and a lawfulBasis for EU/UK/EEA/CH — see
# lib/contacts/sources.js. Blank means no provider configured. Nothing about
# buying a list bypasses suppression, the daily quota, the kill switch, or
# CAN-SPAM. Licensed data feeds E-MAIL ONLY: SMS needs prior express written
# consent, which a purchased number by definition does not have.
CONTACT_PROVIDER_ID=
CONTACT_PROVIDER_API_KEY=
CONTACT_PROVIDER_LICENCE_REF=
# Comma-separated provider ids whose records are refused right now. Use this to
# stop one bad list damaging deliverability without waiting for a deploy.
CONTACT_SOURCE_QUARANTINE=

# ---------------------------------------------------------------------------
# BuildPipeline VSL funnels (routes/gtm-funnels.js, apps/buildpipeline).
# Funnels themselves live in Postgres (gtm_funnels); nothing here sends anything.
# ---------------------------------------------------------------------------
# Calendly webhook signing key. Blank disables /calendly-webhook (503), so
# bookings are then confirmed by an operator via the workspace confirm route.
GTM_CALENDLY_WEBHOOK_SIGNING_KEY=
# Shared with apps/buildpipeline. Lets the funnel app pass the visitor's IP so
# public endpoints rate-limit per visitor, not per funnel server. Blank = limit
# by the caller's own address.
BUILDPIPELINE_PROXY_SECRET=
# Set on apps/buildpipeline (not on this service): origin of this API.
# BUILDPIPELINE_API_URL=https://<this-service>.onrender.com

# Clinic outreach (docs/automated-outreach.md, "Clinic campaign").
# Owner-approved message versions, comma-separated. `npm run outreach:versions`
# prints the current id. Blank = nothing is sendable.
OUTREACH_APPROVED_MESSAGE_VERSIONS=
# New clinics e-mailed per weekday by the daily cron (deliverability ramp).
OUTREACH_DAILY_NEW_CLINICS=20

# HTTP-triggered clinic outreach on the free web service (docs/clinic-outreach-http.md).
# The workflows authenticate with GitHub OIDC tokens (no secret to set).
# CRON_SECRET is optional: it enables x-cron-secret for manual curl. Unset = that
# path is unavailable; the routes are never open.
CRON_SECRET=
# OIDC_AUDIENCE=lion-elite-os-cron
# GITHUB_OIDC_REPOSITORY=lionelite/lion-elite-os
# Ramp: min(DAILY_SEND_MAX, 20 + 10 x full weeks since OUTREACH_START_DATE).
# Before the start date the cap is 0; unset start date holds the ramp at 20.
# DAILY_EMAIL_LIMIT above still applies, so raise it to >= DAILY_SEND_MAX for
# the ramp to reach 150.
DAILY_SEND_MAX=150
OUTREACH_START_DATE=
# Longest a run keeps sending (sends are 30-90 s apart). Leftovers go next run.
OUTREACH_RUN_BUDGET_MINUTES=100
# Extra never-email addresses or bare domains, comma-separated. Only ever adds
# to the list in lib/outreach/never-email.js.
OUTREACH_NEVER_EMAIL=
# Businesses per discovery pass (OpenStreetMap + the clinic's own site).
DISCOVERY_BATCH_SIZE=25
# Google Sheet mirror: the full service-account key JSON. Share the sheet with
# its client_email as Editor. Optional overrides for the sheet id and tab.
GOOGLE_SERVICE_ACCOUNT_JSON=
# GOOGLE_SHEET_ID=1Dwv2gD0BHsHmCgPKHBUR_qeC8msKWjiwL-o7OMAdPoE
# GOOGLE_SHEET_TAB=Pipeline
